{
  "name": "edulinkage",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.3",
      "react": "18.2.0",
      "react-dom": "18.2.0"
    }
  },
  "scripts": {
    "dev:web": "pnpm --filter @edulinkage/web dev",
    "dev:mobile": "pnpm --filter @edulinkage/mobile start",
    "lint": "pnpm -r --filter=./apps/web --filter=./packages/** lint",
    "type-check": "pnpm -r --filter=./apps/web --filter=./packages/** type-check",
    "build": "pnpm -r --filter=./apps/web --filter=./packages/** build"
  }
}
