# Modèle de apps/api/.env.test — environnement de tests ISOLÉ (Phase 2). Aucune valeur réelle ici.
# Copier en apps/api/.env.test (ignoré par Git : .gitignore « .env.* ») puis remplacer chaque <…>
# par une valeur générée localement (ex. python -c "import secrets; print(secrets.token_urlsafe(24))").
# Ne JAMAIS y mettre le mot de passe administrateur PostgreSQL : il vit uniquement dans le fichier
# secret désigné par EDUSPHERE_TEST_ADMIN_SECRET_FILE, HORS du dépôt.
# Ne jamais reprendre de valeur du .env de développement.
EDUSPHERE_TEST_MODE=local
EDUSPHERE_TEST_ADMIN_SECRET_FILE="C:/Users/<vous>/.edusphere-test/pg_admin_password"
EDUSPHERE_TEST_APP_PASSWORD=<mot-de-passe-app>
EDUSPHERE_TEST_CLEANER_PASSWORD=<mot-de-passe-nettoyage>
DATABASE_URL=postgresql+asyncpg://edusphere_app:<mot-de-passe-app>@127.0.0.1:55432/edusphere_test
APP_DATABASE_URL=postgresql+asyncpg://edusphere_app:<mot-de-passe-app>@127.0.0.1:55432/edusphere_test
TEST_CLEANUP_DATABASE_URL=postgresql+asyncpg://edusphere_test_cleaner:<mot-de-passe-nettoyage>@127.0.0.1:55432/edusphere_test
REDIS_URL=redis://127.0.0.1:56379/0
