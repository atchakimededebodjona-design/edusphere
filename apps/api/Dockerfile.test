# Image de TEST uniquement (edusphere-api-test:local, docker-compose.test.yml). Ne remplace pas
# apps/api/Dockerfile (production), qui reste inchangé. Même base et même structure, plus les
# dépendances de développement (pytest, pytest-asyncio, httpx, ruff, mypy).
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt

COPY . .

CMD ["sleep", "infinity"]
