# =========================================================================
# EduSphere — Variables d'environnement (exemple)
# Copier ce fichier en `.env` et remplacer les valeurs. Ne JAMAIS committer .env
# =========================================================================

# --- Environnement ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de données (PostgreSQL 16) ---
# DATABASE_URL : rôle superutilisateur (migrations Alembic uniquement).
POSTGRES_USER=edusphere
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=edusphere
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edusphere:changeme_local_only@db:5432/edusphere

# APP_DATABASE_URL : rôle applicatif non-superutilisateur, sans BYPASSRLS, utilisé par l'API
# à l'exécution — nécessaire pour que les policies Row Level Security s'appliquent réellement
# (un superutilisateur Postgres contourne toujours RLS). Créé par la migration 0002.
APP_DB_PASSWORD=changeme_app_role_local_only
APP_DATABASE_URL=postgresql+asyncpg://edusphere_app:changeme_app_role_local_only@db:5432/edusphere

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Rate limiting login (Phase 7.2) ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Rate limiting mot de passe oublié (Phase 10.1) ---
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# --- Sécurité ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stockage fichiers (interface abstraite StorageProvider) ---
# STORAGE_PROVIDER: "local" en dev. Aucune valeur ne doit figer un hébergeur cloud à ce stade.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# --- Email transactionnel (Phase 9 — interface abstraite EmailProvider) ---
# EMAIL_PROVIDER: "local" en dev/tests (rien n'est réellement envoyé, écrit sous
# EMAIL_LOCAL_PATH) ; "smtp" pour un envoi réel (configurer SMTP_* ci-dessous). Aucun
# fournisseur n'est figé à ce stade, cohérent avec la règle Phase 0 sur le stockage.
EMAIL_PROVIDER=local
EMAIL_LOCAL_PATH=./emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@edusphere.local
SMTP_USE_TLS=true
# Phase 16 — délai (secondes) avant qu'un envoi SMTP soit considéré en échec. 10s convient à la
# plupart des fournisseurs SMTP standards ; à ajuster seulement si le fournisseur retenu l'exige.
SMTP_TIMEOUT_SECONDS=10

# Base des liens de vérification QR des bulletins (Phase 5) — pas d'hébergeur figé, ajuster
# selon l'environnement.
PUBLIC_BASE_URL=http://localhost:8000

# Base de l'app web — le QR des bulletins pointe vers sa page /verify/{code}, pas vers l'API.
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=EduSphere

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
