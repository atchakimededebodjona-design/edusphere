# =========================================================================
# EduSphere — Variables d'environnement (exemple)
# Copier ce fichier en `.env` et remplacer les valeurs. Ne JAMAIS committer .env
# =========================================================================

# --- Environnement ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de données (PostgreSQL 16) ---
# DATABASE_URL : rôle superutilisateur (migrations Alembic uniquement).
POSTGRES_USER=edusphere
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=edusphere
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edusphere:changeme_local_only@db:5432/edusphere

# APP_DATABASE_URL : rôle applicatif non-superutilisateur, sans BYPASSRLS, utilisé par l'API
# à l'exécution — nécessaire pour que les policies Row Level Security s'appliquent réellement
# (un superutilisateur Postgres contourne toujours RLS). Créé par la migration 0002.
APP_DB_PASSWORD=changeme_app_role_local_only
APP_DATABASE_URL=postgresql+asyncpg://edusphere_app:changeme_app_role_local_only@db:5432/edusphere

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Rate limiting login (Phase 7.2) ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Rate limiting mot de passe oublié (Phase 10.1) ---
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# --- Adresse réelle des visiteurs derrière le reverse proxy (2026-11-16) ---
# Uvicorn ne lit X-Forwarded-For / X-Forwarded-Proto que si la connexion vient d'une adresse listée
# ici (127.0.0.1 par défaut). En Docker, nginx atteint l'API via la passerelle du réseau compose
# (`docker network inspect edusphere_default`, 172.18.0.1 en production) : sans ce réglage, l'API
# voit tous les visiteurs à cette adresse et les limites « par IP » deviennent communes à tous.
# Adresses exactes uniquement (uvicorn 0.30.1 : pas de plage CIDR), et jamais « * » : nginx
# ajoute l'adresse réelle EN FIN de X-Forwarded-For, seule une liste précise la retient.
# FORWARDED_ALLOW_IPS=172.18.0.1

# --- Sécurité ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stockage fichiers (interface abstraite StorageProvider) ---
# STORAGE_PROVIDER: "local" en dev. Aucune valeur ne doit figer un hébergeur cloud à ce stade.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# --- Email transactionnel (Phase 9 — interface abstraite EmailProvider) ---
# EMAIL_PROVIDER: "local" en dev/tests (rien n'est réellement envoyé, écrit sous
# EMAIL_LOCAL_PATH) ; "smtp" pour un envoi réel (configurer SMTP_* ci-dessous). Aucun
# fournisseur n'est figé à ce stade, cohérent avec la règle Phase 0 sur le stockage.
EMAIL_PROVIDER=local
EMAIL_LOCAL_PATH=./emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@edulinkage.local
# Sprint 1.7.1 — nom d'affichage de l'expéditeur (ex. "EduLinkage <no-reply@...>" dans la boîte de
# réception du destinataire). Vide par défaut (From = adresse seule) ; en production, régler à
# "EduLinkage" pour l'affichage voulu — ne modifie ni l'adresse SMTP ni aucun autre réglage Brevo.
SMTP_FROM_NAME=
SMTP_USE_TLS=true
# Phase 16 — délai (secondes) avant qu'un envoi SMTP soit considéré en échec. 10s convient à la
# plupart des fournisseurs SMTP standards ; à ajuster seulement si le fournisseur retenu l'exige.
SMTP_TIMEOUT_SECONDS=10

# --- SMS transactionnel (PR #16 — interface abstraite SmsProvider) ---
# SMS_ENABLED : coupe-circuit dédié — faux par défaut, le canal SMS des rappels de frais en
# retard reste désactivé même si SMS_PROVIDER="http" est configuré ci-dessous.
SMS_ENABLED=false
# SMS_PROVIDER : "local" en dev/tests (rien n'est réellement envoyé, écrit sous SMS_LOCAL_PATH) ;
# "http" pour un envoi réel via un endpoint HTTP générique (configurer SMS_HTTP_* ci-dessous).
# Aucun fournisseur n'est figé à ce stade, même principe que EMAIL_PROVIDER ci-dessus.
SMS_PROVIDER=local
SMS_LOCAL_PATH=./sms
SMS_HTTP_URL=
SMS_HTTP_AUTH_TOKEN=
SMS_HTTP_TIMEOUT_SECONDS=10
SMS_SENDER_ID=

# Abonnements des écoles (Phase 29, lot A).
# Validité (jours) d'une facture d'abonnement émise et non payée.
SUBSCRIPTION_INVOICE_VALIDITY_DAYS=30
# Date de lancement de la facturation (AAAA-MM-JJ) : début du trimestre gratuit des écoles déjà en
# service. Vide = aucun trimestre gratuit attribué (app.jobs.grant_free_quarters ne fait rien).
SUBSCRIPTION_LAUNCH_DATE=
# Taux de TVA (%) figé sur chaque nouvelle facture d'abonnement ; les montants de la grille sont TTC.
# Vide = aucune TVA enregistrée (le HT est égal au total). Commission des partenaires calculée sur le HT.
SUBSCRIPTION_VAT_RATE=

# Identité de l'entreprise imprimée sur les reçus d'abonnement. Valeurs propres à l'exploitant :
# uniquement dans le .env du serveur, jamais ici. Un champ vide n'est pas imprimé.
# Valeur contenant des espaces : entre guillemets doubles, ex. BILLING_ADDRESS="Rue X, Ville".
BILLING_TRADE_NAME=EduLinkage
BILLING_LEGAL_NAME=
BILLING_LEGAL_FORM=
BILLING_ADDRESS=
BILLING_NIF=
BILLING_RCCM=
BILLING_TAX_REGIME=
BILLING_PHONE=
BILLING_EMAIL=

# Paiement Mobile Money des abonnements (Phase 29, lot B — PayGate Global, méthode directe).
# Coupe-circuit : false = aucun paiement en ligne, seul le paiement manuel de la plateforme existe.
SUBSCRIPTION_ONLINE_PAYMENT_ENABLED=false
# fake (développement, tests : aucun appel réseau) ou paygate (production uniquement).
PAYMENT_ONLINE_PROVIDER=fake
# SECRET : clé API PayGate. Uniquement dans le .env du serveur de production, jamais ici.
PAYGATE_AUTH_TOKEN=
PAYGATE_API_BASE_URL=https://paygateglobal.com
PAYGATE_TIMEOUT_SECONDS=15
# Plafond par transaction (FCFA) ; au-delà, paiement manuel.
PAYGATE_MAX_AMOUNT=1000000
# Délai sans confirmation après lequel une tentative est close (l'école peut réessayer).
PAYGATE_PENDING_TIMEOUT_MINUTES=15

# Notifications téléphone des annonces (Web Push, 2026-11-17). Paire de clés VAPID propre au serveur,
# générée UNE fois directement dans le .env du serveur, sans l'afficher (la commande ajoute les deux
# lignes elle-même ; ne pas les recopier ici) :
#   docker compose run --rm --no-deps -T api python -m app.jobs.generate_push_keys >> .env
# SECRET : la clé privée. Absentes = pas de notification téléphone (le reste fonctionne).
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact exigé par le protocole (mailto: ou https:). Absent = PUBLIC_WEB_BASE_URL.
# WEB_PUSH_SUBJECT=

# Base des liens de vérification QR des bulletins (Phase 5) — pas d'hébergeur figé, ajuster
# selon l'environnement.
PUBLIC_BASE_URL=http://localhost:8000

# Base de l'app web — le QR des bulletins pointe vers sa page /verify/{code}, pas vers l'API.
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=EduSphere

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
